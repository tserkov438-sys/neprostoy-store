<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEPROSTOY STORE</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --accent-color: #2f81f7;
            --text-color: #ffffff;
            --text-secondary: #8b949e;
            --tag-bg: #21262d;
        }
        body {
            margin: 0; padding: 0;
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding-bottom: 70px;
        }
        header {
            padding: 15px; text-align: center;
            font-weight: bold; font-size: 20px;
            border-bottom: 1px solid #21262d;
            letter-spacing: 1px;
        }
        .search-container { padding: 12px 15px; }
        .search-box {
            width: 100%; padding: 10px 15px;
            background-color: var(--card-bg);
            border: 1px solid #30363d; border-radius: 10px;
            color: var(--text-color); box-sizing: border-box; outline: none;
        }
        .categories {
            display: flex; gap: 8px; overflow-x: auto;
            padding: 0 15px 12px 15px;
        }
        .category-btn {
            background-color: var(--tag-bg); color: var(--text-color);
            border: none; padding: 8px 16px; border-radius: 20px;
            white-space: nowrap; font-size: 13px;
        }
        .category-btn.active { background-color: var(--accent-color); }
        .section-title { padding: 0 15px 10px 15px; font-size: 18px; font-weight: bold; }
        .products-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 12px; padding: 0 15px;
        }
        .product-card {
            background-color: var(--card-bg); border-radius: 12px;
            padding: 10px; display: flex; flex-direction: column;
            justify-content: space-between;
        }
        .product-img {
            width: 100%; height: 140px; object-fit: cover;
            border-radius: 8px; background-color: #fff;
        }
        .product-title { font-size: 14px; font-weight: bold; margin: 8px 0 4px 0; }
        .product-tag {
            display: inline-block; background-color: var(--tag-bg);
            color: var(--text-secondary); font-size: 11px;
            padding: 2px 6px; border-radius: 4px; margin-bottom: 4px;
        }
        .product-size { font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; }
        .product-price { font-size: 14px; font-weight: bold; }
        .bottom-nav {
            position: fixed; bottom: 0; left: 0; right: 0;
            background-color: var(--card-bg); display: flex;
            justify-content: space-around; padding: 10px 0;
            border-top: 1px solid #30363d;
        }
        .nav-item {
            display: flex; flex-direction: column; align-items: center;
            font-size: 11px; color: var(--text-secondary); text-decoration: none;
        }
        .nav-item.active { color: var(--accent-color); }
    </style>
</head>
<body>
    <header>NEPROSTOY STORE</header>
    <div class="search-container">
        <input type="text" class="search-box" placeholder="Поиск по названию, тегам и цветам">
    </div>
    <div class="categories">
        <button class="category-btn active">Все</button>
        <button class="category-btn">Обувь</button>
        <button class="category-btn">Худи</button>
        <button class="category-btn">Куртки</button>
    </div>
    <div class="section-title">Новинки</div>
    <div class="products-grid">
        <div class="product-card">
            <img src="https://via.placeholder.com/150" class="product-img" alt="Supreme">
            <div>
                <div class="product-title">Supreme анорак оригинал</div>
                <div class="product-tag">Куртки</div>
                <div class="product-size">Размер: S~M</div>
            </div>
            <div class="product-price">150.00 BYN</div>
        </div>
        <div class="product-card">
            <img src="https://via.placeholder.com/150" class="product-img" alt="Balenciaga">
            <div>
                <div class="product-title">Balenciaga track</div>
                <div class="product-tag">Обувь</div>
                <div class="product-size">Размер: 38-39</div>
            </div>
            <div class="product-price">150.00 BYN</div>
        </div>
    </div>
    <div class="bottom-nav">
        <a href="#" class="nav-item active">★ Новинки</a>
        <a href="#" class="nav-item">⊞ Каталог</a>
        <a href="#" class="nav-item">♥ Избранное</a>
        <a href="#" class="nav-item">🛒 Корзина</a>
    </div>
    <script>
        window.Telegram.WebApp.expand();
    </script>
</body>
</html>
